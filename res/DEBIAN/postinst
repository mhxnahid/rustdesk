#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/citrusremoteviewer/citrusremoteviewer /usr/bin/citrusremoteviewer

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/citrusremoteviewer.service ]; then
			rm -f /etc/systemd/system/citrusremoteviewer.service /usr/lib/systemd/system/citrusremoteviewer.service /usr/lib/systemd/user/citrusremoteviewer.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/citrusremoteviewer/files/systemd/citrusremoteviewer.service /usr/lib/systemd/system/citrusremoteviewer.service
		# try fix error in Ubuntu 18.04
		# Failed to reload citrusremoteviewer.service: Unit citrusremoteviewer.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/citrusremoteviewer.service:10: Executable path is not absolute: pkill -f "citrusremoteviewer --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/citrusremoteviewer.service
		fi
		systemctl daemon-reload
		systemctl enable citrusremoteviewer
		systemctl start citrusremoteviewer
	fi
fi
